{
  "name": "qpcr-plate-planner",
  "version": "0.1.0",
  "private": true,
  "description": "qPCR 96/384-well plate layout and reaction planning tool",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "build:portable": "node scripts/build-portable.mjs",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs && npm run test:portable",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:portable": "npm run build:portable && node --test tests/portable-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "next": "16.3.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
